{
  "name": "spatial-object-model",
  "private": true,
  "version": "0.1.0",
  "description": "A spatial object model that compiles spatial declarations into a renderer-neutral spatial document.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:articulation-docs": "node scripts/check-articulation-docs.mjs",
    "test:articulation:b": "RELEASE_B_CAPABILITIES=release-b-passive ARTICULATION_RELEASE=B ARTICULATION_REPORT=artifacts/articulation-release-b.json vitest run src/examples/articulationReleaseGate.test.ts",
    "test:articulation:c": "ARTICULATION_RELEASE=C ARTICULATION_REPORT=artifacts/articulation-release-c.json vitest run src/examples/articulationReleaseGate.test.ts",
    "test:articulation": "npm run test:articulation:b && npm run test:articulation:c",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-use-websocket": "^4.13.0",
    "three": "^0.181.2",
    "three-bvh-csg": "^0.0.17",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  }
}
